# Copy to backend/.env for local development. Never commit real values.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=priyonix
JWT_SECRET=REPLACE_WITH_A_RANDOM_BASE64_SECRET_OF_AT_LEAST_32_BYTES
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
ADMIN_RESET_PASSWORD=false

# Comma-separated exact browser origins. Use the Vercel production URL on Render.
CORS_ALLOWED_ORIGINS=http://localhost:5173
ROLE_MIGRATION_ENABLED=true
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
AUTH_TRUST_FORWARDED_FOR=false

PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_DEV_MODE=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=mailer@example.com
MAIL_PASSWORD=REPLACE_WITH_AN_SMTP_APP_PASSWORD
MAIL_FROM=mailer@example.com
MAIL_RESET_LINK_BASE=http://localhost:5173
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
